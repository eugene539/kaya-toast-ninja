{
  "name": "kaya-toast-ninja",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Kaya Toast Ninja: a free fractions arcade for P1 and P2 children by Genius Plus Academy.",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "serve:lan": "bun run build && bun --bun vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests/unit tests/adversarial",
    "test:unit": "bun test tests/unit",
    "test:adversarial": "bun test tests/adversarial",
    "lint:copy": "bun tools/copy-lint.ts",
    "orders": "bun tools/enumerate-orders.ts",
    "solver-diff": "bun tools/solver-diff.ts",
    "ci": "bun run typecheck && bun run test && bun run lint:copy && bun run solver-diff && bun run build",
    "cap:sync": "bun run build && bunx cap sync",
    "android:debug": "bun run cap:sync && cd android && ./gradlew assembleDebug",
    "build:debug": "bun --bun vite build --mode debug --outDir dist-debug",
    "e2e": "bun run build:debug && bun tools/e2e-evidence.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/bun": "1.4.4",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
